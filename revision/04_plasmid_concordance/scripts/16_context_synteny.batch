#!/usr/bin/env python3
"""Step 16: synteny of the carbapenemase genetic context, reference vs test assemblies.

For every carbapenemase gene on each reference plasmid (work/compare/<plasmid>/ref.fasta):
  1. locate the gene with AMRFinderPlus (cached in work/context/<plasmid>/amrfinder.tsv)
  2. extract the gene plus FLANK bp on each side from the circular reference
     (the whole plasmid, centred on the gene, if the plasmid is shorter than gene + 2 x FLANK)
  3. align this window with minimap2 to every test contig of that plasmid
     (files matching --test-glob in work/compare/<plasmid>/, ref.fasta excluded)
  4. classify:
       syntenic                      one alignment covers >= MIN_COV of the window
       syntenic_across_contig_start  same, but only after joining the contig end to its start
                                     (valid only if that test contig is circular; check against stability_long.tsv)
       not_syntenic                  no single alignment covers >= MIN_COV of the window

Outputs
  results/context_synteny_long.tsv     one row per carbapenemase gene x test file
  results/context_synteny_summary.tsv  counts per assembler and depth
  results/context_synteny_files.tsv    which files were used as test contigs and how assembler/depth were parsed

Usage
  16_context_synteny.py [--flank 10000] [--min-cov 0.95] [--preset asm10] [--test-glob '*.fasta']
Environment: minimap2 and amrfinder on PATH; optional AMRFINDER_DB to pin the database release.
"""
import argparse
import csv
import glob
import os
import re
import subprocess
import sys
import tempfile
from collections import defaultdict


def read_fasta(path):
    recs, name, buf = [], None, []
    with open(path) as fh:
        for line in fh:
            line = line.rstrip()
            if line.startswith(">"):
                if name is not None:
                    recs.append((name, "".join(buf)))
                name, buf = line[1:].split()[0], []
            elif line:
                buf.append(line)
    if name is not None:
        recs.append((name, "".join(buf)))
    return recs


def write_fasta(path, recs):
    with open(path, "w") as fh:
        for n, s in recs:
            fh.write(f">{n}\n")
            for i in range(0, len(s), 80):
                fh.write(s[i:i + 80] + "\n")


def circ_window(seq, start, end, flank):
    """start/end 1-based inclusive. Returns (window, 0-based start on reference, length, whole_plasmid)."""
    L = len(seq)
    glen = end - start + 1
    if glen + 2 * flank >= L:
        s0 = (start - 1 - (L - glen) // 2) % L
        return (seq + seq)[s0:s0 + L], s0, L, True
    s0 = (start - 1 - flank) % L
    n = glen + 2 * flank
    return (seq + seq)[s0:s0 + n], s0, n, False


def carbapenemase_genes(ref, out, db):
    if not (os.path.exists(out) and os.path.getsize(out) > 0):
        cmd = ["amrfinder", "-n", ref, "-o", out, "--threads", "2"]
        if db:
            cmd += ["-d", db]
        subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    genes = []
    with open(out) as fh:
        for r in csv.DictReader(fh, delimiter="\t"):
            if "CARBAPENEM" not in (r.get("Subclass") or "").upper():
                continue
            sym = r.get("Element symbol") or r.get("Gene symbol") or "NA"
            genes.append((sym, r["Contig id"], int(r["Start"]), int(r["Stop"]), r["Strand"]))
    return genes


def best_hit(window_fa, recs, tmp, double, preset):
    tfa = os.path.join(tmp, "target.fa")
    write_fasta(tfa, [(n, s + s if double else s) for n, s in recs])
    r = subprocess.run(["minimap2", "-c", "-x", preset, "--secondary=no", tfa, window_fa],
                       capture_output=True, text=True, check=True)
    best = None
    for line in r.stdout.splitlines():
        f = line.split("\t")
        qlen, qs, qe = int(f[1]), int(f[2]), int(f[3])
        cov = (qe - qs) / qlen
        ident = int(f[9]) / int(f[10]) if int(f[10]) else 0.0
        if best is None or cov > best["cov"]:
            best = {"cov": cov, "ident": ident, "contig": f[5], "strand": f[4]}
    return best


def parse_label(fname):
    low = fname.lower()
    asm = "flye" if "flye" in low else "hybracter" if "hybracter" in low else "unknown"
    m = re.search(r"(\d+)\s*x", low)
    return asm, (m.group(1) + "x") if m else "unknown"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--flank", type=int, default=10000)
    ap.add_argument("--min-cov", type=float, default=0.95)
    ap.add_argument("--preset", default="asm10")
    ap.add_argument("--test-glob", default="*.fasta")
    a = ap.parse_args()
    db = os.environ.get("AMRFINDER_DB", "")

    plasmid_dirs = sorted(d for d in glob.glob("work/compare/*") if os.path.exists(os.path.join(d, "ref.fasta")))
    print(f"reference plasmids found: {len(plasmid_dirs)} (expected 93)")
    os.makedirs("results", exist_ok=True)
    long_rows, file_rows, no_gene = [], [], []

    for d in plasmid_dirs:
        pid = os.path.basename(d)
        ref = os.path.join(d, "ref.fasta")
        refrecs = read_fasta(ref)
        refseq = dict(refrecs)
        cdir = os.path.join("work/context", pid)
        os.makedirs(cdir, exist_ok=True)
        genes = carbapenemase_genes(ref, os.path.join(cdir, "amrfinder.tsv"), db)
        if not genes:
            no_gene.append(pid)
            continue
        tests = [f for f in sorted(glob.glob(os.path.join(d, a.test_glob)))
                 if os.path.basename(f) not in ("ref.fasta", "ref.fa")]
        for f in tests:
            asm, depth = parse_label(os.path.basename(f))
            file_rows.append({"plasmid_id": pid, "file": os.path.basename(f), "assembler": asm, "depth": depth})
        with tempfile.TemporaryDirectory() as tmp:
            for gi, (sym, ctg, st, en, strand) in enumerate(genes, 1):
                win, s0, wlen, whole = circ_window(refseq[ctg], st, en, a.flank)
                wfa = os.path.join(tmp, "window.fa")
                write_fasta(wfa, [(f"{pid}_{sym}", win)])
                write_fasta(os.path.join(cdir, f"window_{gi}_{sym}.fasta"), [(f"{pid}_{sym}_{s0}", win)])
                for f in tests:
                    asm, depth = parse_label(os.path.basename(f))
                    recs = read_fasta(f)
                    h = best_hit(wfa, recs, tmp, False, a.preset)
                    status = "syntenic" if h and h["cov"] >= a.min_cov else None
                    h2 = None
                    if status is None:
                        h2 = best_hit(wfa, recs, tmp, True, a.preset)
                        status = "syntenic_across_contig_start" if h2 and h2["cov"] >= a.min_cov else "not_syntenic"
                    use = h2 if (status == "syntenic_across_contig_start") else h
                    long_rows.append({
                        "plasmid_id": pid, "gene": sym, "gene_start": st, "gene_end": en, "gene_strand": strand,
                        "window_bp": wlen, "window_is_whole_plasmid": "yes" if whole else "no",
                        "test_file": os.path.basename(f), "assembler": asm, "depth": depth,
                        "status": status,
                        "best_cov_pct": f"{100 * use['cov']:.1f}" if use else "0.0",
                        "best_identity_pct": f"{100 * use['ident']:.2f}" if use else "",
                        "best_contig": use["contig"] if use else "",
                    })

    def wtsv(path, rows):
        if not rows:
            open(path, "w").close()
            return
        with open(path, "w", newline="") as fh:
            w = csv.DictWriter(fh, list(rows[0].keys()), delimiter="\t")
            w.writeheader()
            w.writerows(rows)

    wtsv("results/context_synteny_long.tsv", long_rows)
    wtsv("results/context_synteny_files.tsv", file_rows)

    summ = defaultdict(lambda: defaultdict(int))
    for r in long_rows:
        k = (r["assembler"], r["depth"])
        summ[k]["genes_assessed"] += 1
        summ[k][r["status"]] += 1
    srows = []
    for (asm, depth), c in sorted(summ.items()):
        srows.append({"assembler": asm, "depth": depth, "genes_assessed": c["genes_assessed"],
                      "syntenic": c["syntenic"],
                      "syntenic_across_contig_start": c["syntenic_across_contig_start"],
                      "not_syntenic": c["not_syntenic"]})
    wtsv("results/context_synteny_summary.tsv", srows)

    print(f"flank {a.flank} bp, min coverage {a.min_cov}, minimap2 preset {a.preset}")
    print(f"plasmids without a carbapenemase gene found by AMRFinderPlus: {len(no_gene)} {' '.join(no_gene)}")
    unknown = sum(1 for r in file_rows if "unknown" in (r["assembler"], r["depth"]))
    print(f"test files: {len(file_rows)}; with unparsed assembler or depth: {unknown} (see results/context_synteny_files.tsv)")
    for r in srows:
        print("\t".join(str(v) for v in r.values()))


if __name__ == "__main__":
    sys.exit(main())
